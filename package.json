{
  "name": "catscan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/electron/main.cjs",
  "description": "Local-first Mac disk usage visualizer.",
  "author": "catscan",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "desktop": "electron .",
    "pack:mac": "electron-builder --mac dir --arm64",
    "pack:mac:x64": "electron-builder --mac dir --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64",
    "dist:mac:x64": "electron-builder --mac dmg --x64",
    "start": "node src/server/app.js",
    "test": "node --test tests/unit/*.test.js tests/contract/*.test.js tests/integration/*.test.js"
  },
  "build": {
    "appId": "app.catscan.desktop",
    "productName": "catscan",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "resources/macos/icon.icns",
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "catscan scans folders you choose so it can show what is using disk space.",
        "NSDocumentsFolderUsageDescription": "catscan scans folders you choose so it can show what is using disk space.",
        "NSDownloadsFolderUsageDescription": "catscan scans folders you choose so it can show what is using disk space.",
        "NSNetworkVolumesUsageDescription": "catscan scans volumes you choose so it can show what is using disk space.",
        "NSRemovableVolumesUsageDescription": "catscan scans volumes you choose so it can show what is using disk space."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "backgroundColor": "#050505",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
